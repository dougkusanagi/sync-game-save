  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@wailsio/runtime": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
